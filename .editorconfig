# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project across various editors and IDEs
# https://editorconfig.org

root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Kotlin files
[*.kt]
indent_size = 4
# ktlint: standard rule (120 chars)
max_line_length = 120

# XML files (AndroidManifest, resources)
[*.xml]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# Gradle files
[*.gradle.kts]
indent_size = 4

# Properties files
[*.properties]
indent_size = 4
